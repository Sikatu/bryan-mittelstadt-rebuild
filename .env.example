# Public deployment environment: development, staging, or production.
NEXT_PUBLIC_SITE_ENV=staging

# Absolute HTTPS origin used for metadata, canonicals, sitemap, and robots.
# Example staging value: https://preview.example.com
NEXT_PUBLIC_SITE_URL=

# Optional verified HTTPS contact form endpoint. Leave blank to use email fallback.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Hosting provider selected in deployment.config.json: vercel, node, or other.
DEPLOYMENT_PROVIDER=unselected

# Absolute URL used by npm run qa:remote after deployment.
REMOTE_SMOKE_URL=
